# Copy this file to .env and fill actual values before deployment.

# Public URL of backend service (used in status/video links)
PUBLIC_BASE_URL=https://your-backend-domain.com

# Frontend allowed origins for backend CORS (comma-separated)
CORS_ORIGINS=https://your-frontend-domain.com,http://localhost:3000

# Frontend server-side route proxy target
BACKEND_API_URL=http://backend:8000

# Optional for browser-direct calls; not used by current UI but kept for compatibility
NEXT_PUBLIC_API_URL=https://your-backend-domain.com

# AI provider keys
GEMINI_API_KEY=replace_me
OPENAI_API_KEY=replace_me
